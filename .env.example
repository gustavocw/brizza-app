# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* são embutidas no bundle.
# Brizza API local (simulador iOS). Android emulador: http://10.0.2.2:8080. Device: IP da máquina.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google Maps (nativo, lido no build pelo app.config). Habilite no Google Cloud
# "Maps SDK for Android" e "Maps SDK for iOS". A mesma chave serve para os dois.
# Depois de preencher, rode: npx expo prebuild --clean && npm run ios|android
GOOGLE_MAPS_API_KEY=
