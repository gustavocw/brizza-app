{
  "name": "brizze-mobile",
  "version": "1.0.20",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "prebuild": "expo prebuild --clean",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "device": "npx expo run:ios --device",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "xcode": "open ios/*.xcworkspace"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "iconsax-react-nativejs": "^0.0.8",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^21.5.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.8.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "^6.0.3"
  },
  "private": true
}
